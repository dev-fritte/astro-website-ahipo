---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PrivacyDe from '@/components/legal/PrivacyDe.astro';
import {getLocaleParams, type Lang, useTranslations} from '@/i18n';

export const getStaticPaths = () => getLocaleParams();

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

// Legal texts per language; languages without their own text fall back to German
const texts: Record<string, typeof PrivacyDe> = {de: PrivacyDe};
const Text = texts[locale] ?? PrivacyDe;
---

<BaseLayout title={`${t('personal.name')} - ${t('general.privacy')}`} description={t('hero.title')}>
    <Text/>
</BaseLayout>
