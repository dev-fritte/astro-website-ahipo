---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Hero from '@/components/Hero.astro';
import Features from '@/components/Features.astro';
import Content1 from '@/components/Content1.astro';
import ContactBlock from '@/components/ContactBlock.astro';
import {getLocaleParams, type Lang, useTranslations} from '@/i18n';

export const getStaticPaths = () => getLocaleParams();

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);
---

<BaseLayout title={`${t('personal.name')} | ${t('hero.title')}`}
            description={`${t('hero.title')} in ${t('personal.address.city')}`}>
    <Hero/>
    <Features/>
    <Content1/>
    <ContactBlock/>
</BaseLayout>
