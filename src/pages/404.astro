---
import BaseLayout from '@/layouts/BaseLayout.astro';
import {type Lang, useTranslations} from '@/i18n';

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);
---

<BaseLayout title={`${t('personal.name')} | 404`} description={t('hero.title')} noindex>
    <section class="section-y">
        <div class="container-x flex flex-col gap-10">
            <div class="flex flex-col gap-4" lang="de">
                <h1 class="section-title">Seite nicht gefunden</h1>
                <p>Die aufgerufene Seite existiert nicht oder wurde verschoben.</p>
                <a href="/de/" class="font-medium">Zur Startseite</a>
            </div>
            <div class="flex flex-col gap-4" lang="en">
                <h2 class="section-title">Page not found</h2>
                <p>The page you are looking for does not exist or has been moved.</p>
                <a href="/en/" class="font-medium">Back to the home page</a>
            </div>
        </div>
    </section>
</BaseLayout>
