---
import type {Lang} from '../i18n';
import ContentBlock from '@/components/ContentBlock.astro'
import LanguageSwitch from '@/components/LanguageSwitch.astro'
import {Icon} from 'astro-icon/components';
import {getRelativeLocaleUrl} from 'astro:i18n';

const locale = Astro.currentLocale as Lang;
---

<nav class={'w-full h-20 flex fixed bg-corporate-light'}>
    <ContentBlock disableVerticalPadding={true}>
        <div class="w-full flex justify-between items-center">
            <a class={'w-48 h-32 md:w-80 md:h-full flex items-center'} href={getRelativeLocaleUrl(locale)}>
                <Icon name={'ahipo_logo'} width={'100%'} height={'100%'}/>
            </a>

            <div class={'flex gap-4'}>
                <LanguageSwitch/>
            </div>
        </div>
    </ContentBlock>
</nav>
