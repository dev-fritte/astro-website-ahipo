---
import {getLocalePaths, type Lang, useTranslations} from '@/i18n';

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

// Link to the same page in the other language; the 404 page has no counterpart, so it links to the home page
const other = getLocalePaths(Astro.url).find(({lang}) => lang !== locale);
const targetPath = other ? (Astro.routePattern === '/404' ? `/${other.lang}/` : other.path) : `/${locale}/`;
const targetLang = other?.lang ?? locale;
---

<a href={targetPath}
   hreflang={targetLang}
   aria-label={t('lang.switch')}
   class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-lg bg-corporate-main px-4 text-[0.9375rem] font-medium tracking-[0.04em] text-corporate-light no-underline hover:bg-corporate-dark hover:text-corporate-light">
    DE/EN
</a>
