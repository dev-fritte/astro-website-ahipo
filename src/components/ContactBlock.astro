---
import {type Lang, useTranslations} from '@/i18n';
import {Icon} from 'astro-icon/components';
import {CONTACT, mailHref, phoneHref, whatsappHref} from '@/contact';

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const contacts = [
    {icon: 'mdi:telephone', label: 'contact.phone', value: CONTACT.phone, href: phoneHref(CONTACT.phone)},
    {icon: 'mdi:email-outline', label: 'contact.email', value: CONTACT.email, href: mailHref(CONTACT.email)},
    {icon: 'mdi:whatsapp', label: 'contact.whatsapp', value: CONTACT.mobile, href: whatsappHref(CONTACT.mobile)},
];
---

<section id="kontakt" class="section-y on-purple bg-corporate-main text-corporate-light">
    <div class="container-x flex flex-col gap-8 md:gap-12">
        <h2 class="text-[clamp(2rem,3.4vw,2.875rem)] font-light leading-[1.2] tracking-[0.02em]">{t('general.contact')}</h2>
        <div class="grid grid-cols-1 gap-3 md:gap-5 lg:grid-cols-3">
            {contacts.map(({icon, label, value, href}) => (
                <a href={href}
                   class="flex min-w-0 items-center gap-4 rounded-2xl bg-corporate-light p-5 text-corporate-dark no-underline hover:bg-white hover:text-corporate-dark md:gap-5 md:p-7">
                    <Icon name={icon} size={34} class="flex-none" aria-hidden="true"/>
                    <span class="flex min-w-0 flex-col gap-0.5">
                        <span class="text-[0.8125rem] font-semibold uppercase tracking-[0.14em]">{t(label)}</span>
                        <span class="break-words text-lg font-medium leading-[1.3] md:text-[1.1875rem]">{value}</span>
                    </span>
                </a>
            ))}
        </div>
    </div>
</section>
