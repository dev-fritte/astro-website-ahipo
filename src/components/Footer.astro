---
import {Icon} from 'astro-icon/components';
import {SOCIAL} from '@/contact';
import {type Lang, useTranslations} from '@/i18n';

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const socials = [
    {icon: 'mdi:instagram', label: 'footer.instagram', href: SOCIAL.instagram},
    {icon: 'mdi:xing', label: 'footer.xing', href: SOCIAL.xing},
];
---

<footer class="pb-8 pt-12 md:pb-10 md:pt-14">
    <div class="container-x">
        <div class="flex flex-col gap-8 md:flex-row md:justify-between md:gap-16">
            <address class="flex flex-col gap-0.5 not-italic">
                <span class="font-semibold text-corporate-main">{t('personal.name')}</span>
                <span>{t('hero.title')}</span>
                <span>{t('personal.address.street')}</span>
                <span>{t('personal.address.city')}</span>
            </address>
            <div>
                <p class="font-semibold text-corporate-main">{t('footer.socials.title')}</p>
                <div class="mt-1 flex gap-2">
                    {socials.map(({icon, label, href}) => (
                        <a href={href} target="_blank" rel="noopener noreferrer" aria-label={t(label)}
                           class="inline-flex size-11 items-center justify-center">
                            <Icon name={icon} size={32} aria-hidden="true"/>
                        </a>
                    ))}
                </div>
            </div>
        </div>
        <div class="mt-8 flex flex-wrap gap-x-6 border-t border-corporate-line-soft pt-3 text-[0.9375rem] md:mt-10">
            <a href={`/${locale}/imprint`} class="inline-flex min-h-11 items-center">{t('general.imprint')}</a>
            <a href={`/${locale}/privacy`} class="inline-flex min-h-11 items-center">{t('general.privacy')}</a>
        </div>
    </div>
</footer>
