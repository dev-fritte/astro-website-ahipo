---
import {Icon} from 'astro-icon/components';
import {type Lang, useTranslations} from '@/i18n';

const locale = Astro.currentLocale as Lang;
const t = useTranslations(locale);

const services = [
    {icon: 'mdi:legal', title: 'features.legal.title', text: 'features.legal.text'},
    {icon: 'mdi:handshake-outline', title: 'features.assistance.title', text: 'features.assistance.text'},
];
---

<section id="leistungen" class="section-y">
    <div class="container-x flex flex-col gap-8 md:gap-14">
        <h2 class="section-title max-w-[720px]">{t('features.title')}</h2>
        <div class="grid grid-cols-1 gap-5 lg:grid-cols-2 lg:gap-8">
            {services.map(({icon, title, text}) => (
                <article class="flex flex-col gap-4 rounded-2xl bg-white p-7 shadow-card md:gap-5 md:p-11">
                    <div class="flex size-[60px] items-center justify-center rounded-full bg-corporate-tint text-corporate-main">
                        <Icon name={icon} size={30} aria-hidden="true"/>
                    </div>
                    <h3 class="hyphens-auto break-words text-[clamp(1.375rem,2.2vw,1.75rem)] font-medium leading-tight text-corporate-main">
                        {t(title)}
                    </h3>
                    <p>{t(text)}</p>
                </article>
            ))}
        </div>
    </div>
</section>
