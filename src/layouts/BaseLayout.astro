---
import {SEO} from 'astro-seo';
import Header from '@/components/Header.astro';
import Footer from '../components/Footer.astro';

import fontUrl from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import '@/styles/global.css'
import 'vanilla-cookieconsent/dist/cookieconsent.css';

interface Props {
    title: string;
    description: string;
    noindex?: boolean;
}

const {title, description, noindex = false} = Astro.props;

import {SITE_TITLE, SITE_DESCRIPTION} from '@/consts';
import {ADDRESS, CONTACT} from '@/contact';
import {useTranslations, LOCALES, getLocalePaths, DEFAULT_LOCALE, type Lang} from '@/i18n';

const language = Astro.currentLocale as Lang
const t = useTranslations(language);

const toAbsolute = (path: string) => new URL(path, Astro.site).href;
const canonicalUrl = toAbsolute(Astro.url.pathname);
const alternates = getLocalePaths(Astro.url).map(({lang, path}) => ({lang, href: toAbsolute(path)}));
const defaultAlternate = alternates.find(({lang}) => lang === DEFAULT_LOCALE);
const ogLocales: Record<string, string> = {de: 'de_DE', en: 'en_US'};
const isHome = Astro.url.pathname.replace(/\/$/, '') === `/${language}`;

const structuredData = {
    '@context': 'https://schema.org',
    '@type': 'LegalService',
    name: t('personal.name'),
    description: t(SITE_DESCRIPTION),
    url: toAbsolute(`/${language}/`),
    image: toAbsolute('/og-image.png'),
    telephone: CONTACT.phone,
    email: CONTACT.email,
    address: {
        '@type': 'PostalAddress',
        streetAddress: ADDRESS.street,
        postalCode: ADDRESS.postalCode,
        addressLocality: ADDRESS.cityLong,
        addressCountry: ADDRESS.countryCode,
    },
};

const localeTitle = title ? `${title}` : t(SITE_TITLE);
const localeDescription = description || t(SITE_DESCRIPTION);
---
<html lang={language} class={'h-full'}>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <meta name="author" content={t('personal.name')}/>
    <meta name="keywords" content={`${t('personal.name')}, ${t('hero.title')}, ${t('personal.address.city')}`}/>
    <link rel="icon" href="/favicon.ico">
    <link rel="sitemap" href="/sitemap-index.xml"/>
    <!--font preload -->
    <link rel="preload" href={fontUrl} as="font" type="font/woff2" crossorigin/>

    <SEO
            canonical={canonicalUrl}
            noindex={noindex}
            extend={{
                link: noindex ? [] : [
                    ...alternates.map(({lang, href}) => ({rel: 'alternate', hreflang: lang, href})),
                    ...(defaultAlternate ? [{rel: 'alternate', hreflang: 'x-default', href: defaultAlternate.href}] : []),
                ],
            }}
            title={t(localeTitle)}
            description={t(localeDescription)}
            titleDefault={t(localeTitle)}
            openGraph={{
                basic: {
                    title: title,
                    type: 'website',
                    url: canonicalUrl,
                    image: toAbsolute('/og-image.png'),
                },
                image: {
                    alt: t('personal.name'),
                    width: 750,
                    height: 750,
                    type: 'image/png',
                },
                optional: {
                    locale: ogLocales[language],
                    localeAlternate: Object.entries(ogLocales).filter(([lang]) => lang !== language).map(([, l]) => l),
                    siteName: t(SITE_TITLE),
                }
            }}

    />
    {isHome && <script type="application/ld+json" set:html={JSON.stringify(structuredData)}/>}
</head>
<body class="flex min-h-full flex-col bg-corporate-light text-base leading-[1.7] text-ink md:text-[1.0625rem]">
<a href="#main"
   class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-corporate-dark focus:px-5 focus:py-3 focus:font-medium focus:text-corporate-light focus:no-underline focus:hover:text-corporate-light">
    {t('nav.skip')}
</a>
<Header/>
<main id="main" class="flex flex-1 flex-col">
    <slot/>
</main>
<Footer/>
</body>
</html>
